msgid "This plugin requires WordPress 5.8 or higher."
msgstr "Dieses Plugin benötigt WordPress 5.8 oder höher."

#: logo-slider-block.php
msgid "Plugin activation failed"
msgstr "Plugin-Aktivierung fehlgeschlagen"

msgid "Logo"
msgstr "Logo"

# Link Settings Panel (now English base strings)
msgid "Link Settings"
msgstr "Link-Einstellungen"

msgid "Link Target"
msgstr "Link-Ziel"

msgid "Determines where logo links open."
msgstr "Bestimmt, wo Logo-Links geöffnet werden."

msgid "Same window (_self)"
msgstr "Gleiches Fenster (_self)"

msgid "New window (_blank)"
msgstr "Neues Fenster (_blank)"

msgid "Rel Attributes"
msgstr "Rel-Attribute"

msgid "Separate multiple values with spaces (e.g. 'nofollow sponsored')."
msgstr "Mehrere Werte mit Leerzeichen trennen (z.B. 'nofollow sponsored')."

msgid "Title Attribute (optional)"
msgstr "Title-Attribut (optional)"

msgid "Tooltip text for all logo links."
msgstr "Tooltip-Text für alle Logo-Links."

msgid "Visit our partner"
msgstr "Besuche unseren Partner"

# New strings for alt text and URL validation
msgid "Alt Text (optional)"
msgstr "Alt-Text (optional)"

msgid "Describe this logo"
msgstr "Beschreiben Sie dieses Logo"

# New strings for v1.3 multi-row layout
msgid "Layout"
msgstr "Layout"

msgid "Display Mode"
msgstr "Anzeigemodus"

msgid "Single Row"
msgstr "Einzelne Reihe"

msgid "Multiple Rows"
msgstr "Mehrere Reihen"

msgid "Number of Rows"
msgstr "Anzahl der Reihen"

msgid "Row Speed"
msgstr "Reihen-Geschwindigkeit"

msgid "Uniform"
msgstr "Einheitlich"

msgid "Varied"
msgstr "Variiert"

msgid "Uniform: all rows move at the same speed. Varied: each row moves slightly differently for a more dynamic look."
msgstr "Einheitlich: Alle Reihen bewegen sich gleich schnell. Variiert: Jede Reihe bewegt sich leicht unterschiedlich für ein dynamischeres Erscheinungsbild."

msgid "Logos are distributed evenly across the rows. Adjacent rows scroll in opposite directions."
msgstr "Die Logos werden gleichmäßig auf die Reihen verteilt. Benachbarte Reihen scrollen in entgegengesetzte Richtungen."

# New strings for v1.4 capsule style
msgid "Capsule Style"
msgstr "Kapsel-Stil"

msgid "Enable Capsules"
msgstr "Kapseln aktivieren"

msgid "Places each logo inside a rounded background container."
msgstr "Platziert jedes Logo in einem abgerundeten Hintergrund-Container."

msgid "Background Style"
msgstr "Hintergrund-Stil"

msgid "Uniform: all capsules use one color. Alternating: capsules alternate between two colors in a checkerboard."
msgstr "Einheitlich: Alle Kapseln verwenden eine Farbe. Abwechselnd: Die Kapseln wechseln im Schachbrettmuster zwischen zwei Farben."

msgid "Alternating"
msgstr "Abwechselnd"

msgid "Corner Style"
msgstr "Eckenform"

msgid "Square"
msgstr "Eckig"

msgid "Rounded"
msgstr "Abgerundet"

msgid "Pill"
msgstr "Pille"

msgid "Custom"
msgstr "Benutzerdefiniert"

msgid "Custom Corner Radius (px)"
msgstr "Eigene Eckenrundung (px)"

msgid "Capsule Colors"
msgstr "Kapsel-Farben"

msgid "Color A"
msgstr "Farbe A"

msgid "Color B"
msgstr "Farbe B"

msgid "Capsule color"
msgstr "Kapsel-Farbe"

msgid "For a flawless checkerboard, use an even total number of logos."
msgstr "Für ein lückenloses Schachbrettmuster eine gerade Gesamtanzahl an Logos verwenden."

msgid "Row Gap"
msgstr "Reihen-Abstand"

msgid "Padding"
msgstr "Innenabstand"

msgid "Custom Padding (px)"
msgstr "Eigener Innenabstand (px)"

msgid "Custom Speed (seconds)"
msgstr "Eigene Geschwindigkeit (Sekunden)"

msgid "A higher value means slower scrolling."
msgstr "Ein höherer Wert bedeutet langsameres Scrollen."

# New strings for v1.5 (outline style, glow, rename)
msgid "Logo Slider"
msgstr "Logo Slider"

msgid "Outline"
msgstr "Umriss"

msgid "Border Width"
msgstr "Rahmenstärke"

msgid "Thin"
msgstr "Dünn"

msgid "Thick"
msgstr "Dick"

msgid "Custom Border Width (px)"
msgstr "Eigene Rahmenstärke (px)"

msgid "Logo Color"
msgstr "Logo-Farbe"

msgid "Outline capsules have no background — choose how the logos are colored."
msgstr "Umriss-Kapseln haben keinen Hintergrund – wähle, wie die Logos eingefärbt werden."

msgid "Original"
msgstr "Original"

msgid "White"
msgstr "Weiß"

msgid "Black"
msgstr "Schwarz"

msgid "Glow Effect"
msgstr "Leucht-Effekt"

msgid "Adds a soft colored glow around each capsule."
msgstr "Fügt jeder Kapsel einen sanften farbigen Schein hinzu."

msgid "Glow Intensity"
msgstr "Leuchtstärke"

msgid "Subtle"
msgstr "Dezent"

msgid "Strong"
msgstr "Stark"

msgid "Custom Glow Size (px)"
msgstr "Eigene Leuchtstärke (px)"

# Plugin header metadata (Plugins screen)
msgid "A professional infinity logo carousel Gutenberg block with customizable speed, spacing, hover-stop and optional links. Perfect for showcasing partner, client or sponsor logos."
msgstr "Ein professioneller Endlos-Logo-Karussell-Block für Gutenberg mit anpassbarer Geschwindigkeit, Abständen, Hover-Stopp und optionalen Links. Perfekt zur Präsentation von Partner-, Kunden- oder Sponsoren-Logos."

# New strings for v1.6 (logo color mode)
msgid "Applies a uniform color to all logos for a cohesive look."
msgstr "Wendet eine einheitliche Farbe auf alle Logos an, für einen stimmigen Look."

msgid "Custom Color"
msgstr "Eigene Farbe"

msgid "Auto-Contrast"
msgstr "Auto-Kontrast"

msgid "Auto-Contrast picks white or black based on the capsule background. Choose Original Colors to keep your logos unchanged."
msgstr "Auto-Kontrast wählt Weiß oder Schwarz passend zum Kapsel-Hintergrund. Wähle Originalfarben, um deine Logos unverändert zu lassen."

msgid "Original Colors"
msgstr "Originalfarben"

# New strings for v1.7 (mobile logo height)
msgid "Custom height on phones"
msgstr "Eigene Höhe auf Smartphones"

msgid "By default, logos scale down automatically on small screens. Enable this to set a fixed logo height for phones instead."
msgstr "Standardmäßig verkleinern sich Logos auf kleinen Bildschirmen automatisch. Aktiviere diese Option, um stattdessen eine feste Logo-Höhe für Smartphones festzulegen."

msgid "Mobile Logo Height (px)"
msgstr "Mobile Logo-Höhe (px)"

msgid "Applies on screens narrower than 600px."
msgstr "Gilt für Bildschirme schmaler als 600px."
